#!/usr/bin/env bash
# 信号灯服务器管理命令（由 install.sh 安装到 /usr/local/bin/signallight）
set -euo pipefail
SL_HOME="${SL_HOME:-/opt/signallight}"
CUR="$SL_HOME/current"
[ -d "$CUR" ] || { echo "未找到 $CUR，请先运行 install.sh" >&2; exit 1; }
. "$CUR/scripts/common.sh"

cmd="${1:-help}"
shift || true
case "$cmd" in
  status)
    echo "${c_bold}版本：${c_off}$(release_version "$(current_release)")  （$(current_release)）"
    if [ "$SL_NO_SYSTEMD" != "1" ]; then systemctl --no-pager --lines=0 status "$SL_SERVICE" | head -5 || true; fi
    echo "${c_bold}健康检查：${c_off}"
    curl -fsS --max-time 5 "http://127.0.0.1:$(port)/api/health" && echo || echo "  ${c_red}无响应${c_off}"
    echo "${c_bold}数据源连通性：${c_off}"
    check_sources
    echo "${c_bold}磁盘：${c_off}数据库与备份 $(du -sh --exclude=.home "$SL_DATA" 2>/dev/null | cut -f1)，剩余 $(df -h / | awk 'NR==2 {print $4}')"
    if [ "$SL_NO_SYSTEMD" != "1" ]; then
      echo "${c_bold}最近的错误：${c_off}"
      journalctl -u "$SL_SERVICE" --since "-24h" --no-pager -p warning -n 10 2>/dev/null || true
      journalctl -u "$SL_SERVICE" --since "-24h" --no-pager -n 200 2>/dev/null | grep -E "\[(error|warn)\]" | tail -10 || true
    fi
    ;;
  logs) require_root; journalctl -u "$SL_SERVICE" -f -n "${1:-100}" ;;
  start) require_root; systemctl start "$SL_SERVICE" ;;
  stop) require_root; service_stop ;;
  restart) require_root; service_restart; wait_healthy "" 60 && info "已重启" ;;
  update) require_root; bash "$CUR/scripts/update.sh" "$@" ;;
  rollback) require_root; bash "$CUR/scripts/rollback.sh" "$@" ;;
  backup) require_root; cli "$CUR" backup "$@" ;;
  restore)
    require_root
    [ -n "${1:-}" ] || die "用法：signallight restore <备份文件>（备份在 $SL_DATA/backups/）"
    service_stop; cli "$CUR" restore "$1"; service_restart; wait_healthy "" 60 && info "已恢复并重启"
    ;;
  admin)
    require_root
    read -r -p "管理员用户名 [admin]: " U </dev/tty || true
    read -r -s -p "新密码（留空则自动生成）: " P </dev/tty || true; echo
    if [ -n "$P" ]; then cli "$CUR" admin --user "${U:-admin}" --password "$P"; else cli "$CUR" admin --user "${U:-admin}"; fi
    ;;
  config) require_root; "${EDITOR:-nano}" "$SL_ENV"; echo "修改完成后执行：sudo signallight restart" ;;
  version) release_version "$(current_release)" ;;
  diagnose) require_root; bash "$CUR/scripts/diagnose.sh" ;;
  history) require_root; cli "$CUR" history "$@" ;;
  research) require_root; cli "$CUR" research "$@" ;;
  compare) require_root; as_service nice -n 10 node --no-warnings --experimental-strip-types "$CUR/scripts/cli.ts" compare "$@" ;;
  plan) require_root; cli "$CUR" plan "$@" ;;
  help|*)
    cat <<HELP
信号灯管理命令：
  signallight status            运行状态、健康检查、数据源连通性、最近错误
  signallight logs [行数]        实时查看服务日志（Ctrl+C 退出）
  signallight start|stop|restart
  signallight update [--force] [--branch main]
                                更新到最新发布版本（先备份，失败自动回滚）；--branch 跟随分支
  signallight rollback [--list | 版本目录] [--restore-db]
  signallight backup            立即备份数据库
  signallight restore <文件>     从备份恢复数据库
  signallight admin             创建管理员或重置密码
  signallight config            编辑配置文件
  signallight history [--sync]  本地 K 线历史覆盖情况；--sync 立即补齐 K 线、主动买入量、标记价格和持仓量归档（平时后台会慢慢自动补）
  signallight research [--all]  立即生成研究报告并打印结论（平时每周自动生成，后台“研究报告”页可看）
  signallight compare --set 参数=值 [--tf 1h] [--step 3]
                                改参数前先对比：在同一批历史时点上回放新旧信号灯，对比成绩单（较耗 CPU，已降低优先级）
  signallight plan [--coin BTC] [--fw 4h|1d] [--at "2026-09-23 20:00"]
                                趋势地图和多空计划；--at 回放某根 K 线（北京时间开盘时刻）收盘时的计划和之后的结果
  signallight diagnose          生成体检报告（只读；密钥和访问者 IP 已隐藏，可发给开发者分析）
  signallight version           查看当前版本
HELP
    ;;
esac
